<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#d0d0d0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar Nombre de Perfil"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1a1c1c"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresa tu nuevo nombre para actualizar tu cuenta en Wicho Burger."
        android:textSize="14sp"
        android:textColor="#5e5e5e"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etEditProfileName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Tu nombre completo"
        android:inputType="textPersonName"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:textColor="#1a1c1c"
        android:layout_marginBottom="24dp"
        android:autofillHints="name" />

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GUARDAR CAMBIOS"
        android:textColor="#705e00"
        android:textStyle="bold"
        app:backgroundTint="#ffd700"
        app:cornerRadius="12dp"/>

</LinearLayout>
